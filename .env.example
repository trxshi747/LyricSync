# Spotify Web API Credentials (https://developer.spotify.com/dashboard)
SPOTIFY_CLIENT_ID=your_spotify_client_id_here
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret_here
SPOTIFY_REDIRECT_URI=http://localhost:3001/auth/callback

# Groq Cloud API Key for Whisper Large v3 & LLaMA 3.3 (https://console.groq.com/)
GROQ_API_KEY=your_groq_api_key_here

# Optional: Last.fm API Key
LASTFM_API_KEY=your_lastfm_api_key_here

# App Ports and URLs
PORT=3001
FRONTEND_URL=http://localhost:5173

# Optional: YouTube cookies to prevent datacenter IP bot detection when running yt-dlp on cloud hosts
# YOUTUBE_COOKIES="paste_cookies_txt_content_here"
